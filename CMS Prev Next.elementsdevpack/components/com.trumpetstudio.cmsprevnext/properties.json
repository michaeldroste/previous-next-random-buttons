    {
      "title": "Layout",
      "icon": "square.split.2x1",
      "properties": [
        {
          "title": "Horizontal Gap",
          "id": "gapHorizontal",
          "format": "gap-x-[calc({{value}}*0.25rem)]",
          "slider": {
            "default": 10,
            "min": 0,
            "max": 50,
            "step": 1,
            "round": true
          },
          "info": "Space between the buttons while they sit side by side. Steps of the spacing scale, the same numbers the Padding and Margin controls use, so 4 here matches a padding of 4. It starts at 10 because there are three buttons: the distance that separates a pair reads as a gulf once a third sits between them.",
          "ai": {
            "name": "gapHorizontal",
            "description": "Space between the buttons while they are side by side, 0-50 on the spacing scale, per breakpoint."
          }
        },
        {
          "title": "Align To Edges",
          "id": "alignToEdges",
          "responsive": false,
          "switch": {
            "default": false,
            "subtitle": "Previous left, Next right."
          },
          "info": "On pushes the two buttons to opposite ends of the content, the usual blog convention. Off keeps them together as a centred pair, which sits better in a wide column and lines up with anything else centred below them.",
          "ai": {
            "name": "alignToEdges",
            "description": "Push Previous to the left edge and Next to the right edge."
          }
        },
        {
          "title": "Stack On Mobile",
          "id": "stackOnMobile",
          "responsive": false,
          "switch": {
            "default": true
          },
          "info": "One button per row on narrow screens. Only the direction changes: each button keeps the wording size, padding and width it has on a wide screen.",
          "ai": {
            "name": "stackOnMobile",
            "description": "Stack the buttons vertically on narrow screens."
          }
        },
        {
          "title": "Vertical Gap",
          "id": "gapVertical",
          "visible": "stackOnMobile == true",
          "format": "gap-y-[calc({{value}}*0.25rem)]",
          "slider": {
            "default": 5,
            "min": 0,
            "max": 50,
            "step": 1,
            "round": true
          },
          "info": "Space between the buttons once they stack. Same spacing scale as Horizontal Gap, and it starts far lower on purpose: stacked buttons are read as a short list, and the distance that separates a pair side by side reads as a gulf one above the other. Hidden while Stack On Mobile is off, because a single row has nothing to separate vertically.",
          "ai": {
            "name": "gapVertical",
            "description": "Space between the buttons once they stack on a narrow screen, 0-50 on the spacing scale, per breakpoint.",
            "visible": "stackOnMobile == true"
          }
        }
      ]
    },
    {
      "title": "Sizing",
      "icon": "arrow.up.left.and.arrow.down.right",
      "properties": [
        {
          "title": "Button Width",
          "id": "buttonWidth",
          "responsive": false,
          "segmented": {
            "default": "match",
            "items": [
              {
                "value": "match",
                "title": "Match"
              },
              {
                "value": "fit",
                "title": "Fit text"
              },
              {
                "value": "equal",
                "title": "Equal halves"
              }
            ]
          },
          "info": "Match grows the shorter button to the size of the longer one, so a four-letter Next lines up with an eight-letter Previous instead of sitting noticeably thinner. Fit text lets each button hug its own wording. Equal halves stretches both across the whole width, which reads better once item titles are switched on. Align To Edges needs the full width to push the pair apart, and equal buttons filling it are equal halves by another name, so Match becomes Equal halves under it. Showing only one button leaves nothing to match, so Match behaves as Fit text there.",
          "ai": {
            "name": "buttonWidth",
            "description": "Whether both buttons take the width of the wider one, each hugs its own text, or both stretch to an equal half.",
            "values": [
              "match",
              "fit",
              "equal"
            ]
          }
        },
        {
          "title": "Minimum Width",
          "id": "minWidth",
          "format": "min-w-[{{value}}rem]",
          "slider": {
            "default": 0,
            "min": 0,
            "max": 24,
            "step": 1,
            "units": "rem",
            "round": true
          },
