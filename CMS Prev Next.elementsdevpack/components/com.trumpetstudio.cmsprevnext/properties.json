{
  "groups": [
    {
      "title": "Collection",
      "icon": "text.book.closed",
      "properties": [
        {
          "title": "Place this inside a CMS Item, in the Before or After zone. It finds the current item's neighbours when the page is requested, so the page must be published with a .php extension.",
          "information": {}
        },
        {
          "title": "Collection",
          "id": "collectionPath",
          "text": {
            "default": "",
            "placeholder": "posts",
            "subtitle": "Leave empty to find the folder automatically."
          },
          "info": "Folder of Markdown files, relative to this page. Leave empty and the component looks for a folder of items beside and above the page, which covers the usual Collection plus Item Template layout.",
          "ai": {
            "name": "collectionPath",
            "description": "Folder of CMS Markdown items to read, relative to the page. Empty means find it automatically."
          }
        },
        {
          "title": "Levels Up",
          "id": "collectionLevelsUp",
          "responsive": false,
          "number": {
            "default": 0,
            "min": 0,
            "max": 8,
            "step": 1,
            "round": true,
            "subtitle": "Folders to climb before applying the path."
          },
          "info": "Only needed when the collection folder sits above this page rather than beside it. Ignored while Collection is empty.",
          "ai": {
            "name": "collectionLevelsUp",
            "description": "How many folders to climb from the page before resolving the collection path, 0-8."
          }
        },
        {
          "title": "Order By",
          "id": "orderBy",
          "responsive": false,
          "select": {
            "default": "date",
            "items": [
              {
                "value": "date",
                "title": "Date Published"
              },
              {
                "value": "title",
                "title": "Title"
              },
              {
                "value": "filename",
                "title": "File Name"
              }
            ]
          },
          "info": "Must match the Collection that lists these items, or the neighbours will not match the visible order.",
          "ai": {
            "name": "orderBy",
            "description": "Field the items are sorted by. Must match the listing Collection.",
            "values": [
              "date",
              "title",
              "filename"
            ]
          }
        },
        {
          "title": "Order Direction",
          "id": "orderDirection",
          "responsive": false,
          "select": {
            "default": "desc",
            "items": [
              {
                "value": "desc",
                "title": "Descending"
              },
              {
                "value": "asc",
                "title": "Ascending"
              }
            ]
          },
          "info": "Must match the Collection that lists these items.",
          "ai": {
            "name": "orderDirection",
            "description": "Sort direction. Must match the listing Collection.",
            "values": [
              "desc",
              "asc"
            ]
          }
        },
        {
          "title": "\"Previous\" Means",
          "id": "previousMeans",
          "responsive": false,
          "segmented": {
            "default": "older",
            "items": [
              {
                "value": "older",
                "title": "Older"
              },
              {
                "value": "newer",
                "title": "Newer"
              }
            ]
          },
          "info": "Which way the Previous button travels. Older is what most readers expect on a blog. This is decided separately from the sort order, so flipping the sort does not silently swap the buttons.",
          "ai": {
            "name": "previousMeans",
            "description": "Whether the Previous button goes to the older or the newer item.",
            "values": [
              "older",
              "newer"
            ]
          }
        },
        {
          "divider": {}
        },
        {
          "title": "Which Items Count",
          "heading": {}
        },
        {
          "title": "These must match the Collection that lists your items, or the neighbours will not match the order your readers see.",
          "information": {}
        },
        {
          "title": "Status",
          "id": "statusFilter",
          "responsive": false,
          "select": {
            "default": "published",
            "items": [
              {
                "value": "published",
                "title": "Published"
              },
              {
                "value": "draft",
                "title": "Draft"
              },
              {
                "value": "all",
                "title": "All"
              }
            ]
          },
          "ai": {
            "name": "statusFilter",
            "description": "Which item status counts as a neighbour. Must match the listing Collection.",
            "values": [
              "published",
              "draft",
              "all"
            ]
          }
        },
        {
          "title": "Date",
          "id": "dateFilter",
          "responsive": false,
          "select": {
            "default": "past",
            "items": [
              {
                "value": "past",
                "title": "In the past"
              },
              {
                "value": "future",
                "title": "In the future"
              },
              {
                "value": "all",
                "title": "All dates"
              }
            ]
          },
          "info": "In the past keeps scheduled items out of the navigation until their date arrives. The comparison happens when the page is requested, so it stays correct without republishing.",
          "ai": {
            "name": "dateFilter",
            "description": "Which item dates count as neighbours. Must match the listing Collection.",
            "values": [
              "past",
              "future",
              "all"
            ]
          }
        }
      ]
    },
    {
      "title": "Buttons",
      "icon": "rectangle.on.rectangle",
      "properties": [
        {
          "title": "Style",
          "id": "buttonStyle",
          "responsive": false,
          "segmented": {
            "default": "buttons",
            "items": [
              {
                "value": "buttons",
                "title": "Buttons"
              },
              {
                "value": "links",
                "title": "Text"
              },
              {
                "value": "cards",
                "title": "Cards"
              }
            ]
          },
          "info": "Buttons draws a box each side. Text drops the box. Cards adds the item's feature image.",
          "ai": {
            "name": "buttonStyle",
            "description": "Overall treatment: boxed buttons, bare text links, or cards with a feature image.",
            "values": [
              "buttons",
              "links",
              "cards"
            ]
          }
        },
        {
          "title": "Show",
          "id": "pairing",
          "responsive": false,
          "segmented": {
            "default": "pair",
            "items": [
              {
                "value": "pair",
                "title": "Both"
              },
              {
                "value": "single",
                "title": "One"
              }
            ]
          },
          "info": "Both is what readers expect. One is a stronger call to action at the end of show notes, because it points somewhere instead of offering a choice.",
          "ai": {
            "name": "pairing",
            "description": "Show both Previous and Next, or only one of them.",
            "values": [
              "pair",
              "single"
            ]
          }
        },
        {
          "title": "Which One",
          "id": "singleDirection",
          "responsive": false,
          "visible": "pairing == 'single'",
          "select": {
            "default": "next",
            "items": [
              {
                "value": "next",
                "title": "Next only"
              },
              {
                "value": "prev",
                "title": "Previous only"
              }
            ]
          },
          "ai": {
            "name": "singleDirection",
            "description": "Which single button to show when only one is displayed.",
            "values": [
              "next",
              "prev"
            ],
            "visible": "pairing == 'single'"
          }
        },
        {
          "title": "At The Ends",
          "id": "atEnds",
          "responsive": false,
          "segmented": {
            "default": "hide",
            "items": [
              {
                "value": "hide",
                "title": "Hide"
              },
              {
                "value": "disable",
                "title": "Disable"
              },
              {
                "value": "loop",
                "title": "Loop"
              }
            ]
          },
          "info": "What the first and last item do when there is no neighbour in one direction. Loop wraps around, which suits an archive meant to be browsed in a circle.",
          "ai": {
            "name": "atEnds",
            "description": "Behaviour on the first and last item: hide the missing button, show it disabled, or wrap around.",
            "values": [
              "hide",
              "disable",
              "loop"
            ]
          }
        },
        {
          "title": "Show Random Button",
          "id": "showRandom",
          "responsive": false,
          "switch": {
            "default": true,
            "subtitle": "A third button, between the other two."
          },
          "info": "Opens another item from the same collection, chosen at random, so a library can be browsed without an order. It never picks the item being read, and the choice is made when the page is requested rather than when it was published. At The Ends applies to it as well: with only one item there is nowhere random to go.",
          "ai": {
            "name": "showRandom",
            "description": "Show a third button between Previous and Next that opens a randomly chosen item from the same collection."
          }
        },
        {
          "divider": {}
        },
        {
          "title": "What Each Button Shows",
          "heading": {}
        },
        {
          "title": "Show Labels",
          "id": "showLabels",
          "responsive": false,
          "switch": {
            "default": true,
            "subtitle": "The Previous / Next wording."
          },
          "ai": {
            "name": "showLabels",
            "description": "Show the Previous and Next wording on the buttons."
          }
        },
        {
          "title": "Previous Label",
          "id": "labelPrevious",
          "visible": "showLabels == true",
          "text": {
            "default": "Previous"
          },
          "ai": {
            "name": "labelPrevious",
            "description": "Wording for the Previous label.",
            "visible": "showLabels == true"
          }
        },
        {
          "title": "Next Label",
          "id": "labelNext",
          "visible": "showLabels == true",
          "text": {
            "default": "Next"
          },
          "ai": {
            "name": "labelNext",
            "description": "Wording for the Next label.",
            "visible": "showLabels == true"
          }
        },
        {
          "title": "Random Label",
          "id": "labelRandom",
          "visible": "showLabels == true && showRandom == true",
          "text": {
            "default": "Random"
          },
          "ai": {
            "name": "labelRandom",
            "description": "Wording for the Random label.",
            "visible": "showLabels == true && showRandom == true"
          }
        },
        {
          "title": "Show Item Titles",
          "id": "showTitles",
          "responsive": false,
          "switch": {
            "default": false,
            "subtitle": "Adds the neighbouring item's headline."
          },
          "ai": {
            "name": "showTitles",
            "description": "Show the neighbouring item's headline inside the button."
          }
        },
        {
          "title": "Show Icons",
          "id": "showChevrons",
          "responsive": false,
          "switch": {
            "default": true,
            "subtitle": "Arrows on Previous and Next, dice on Random."
          },
          "ai": {
            "name": "showChevrons",
            "description": "Show the chevron arrow on Previous and Next, and the dice on Random."
          }
        },
        {
          "title": "Show Feature Image",
          "id": "showFeatureImage",
          "responsive": false,
          "visible": "buttonStyle == 'cards'",
          "switch": {
            "default": true
          },
          "info": "Reads the item's image frontmatter. Items without one fall back to text only.",
          "ai": {
            "name": "showFeatureImage",
            "description": "Show the neighbouring item's feature image on the card.",
            "visible": "buttonStyle == 'cards'"
          }
        }
      ]
    },
